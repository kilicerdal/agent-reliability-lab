{
  "name": "agent-reliability-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/recordings.mjs && next dev --hostname 127.0.0.1 --port 3310",
    "build": "node scripts/recordings.mjs && next build",
    "build:public": "LAB_STATIC_EXPORT=1 npm run build",
    "start": "next start --hostname 127.0.0.1 --port 3310",
    "test:browser": "playwright test",
    "test:public": "playwright test --config playwright.public.config.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.10.1",
    "typescript": "^5.9.0"
  }
}
